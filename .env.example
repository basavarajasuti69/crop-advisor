# Copy this to .env and fill in values
CA_REGION=ap-south-1
# Comma-separated allowed origins, no trailing slashes.
CA_CORS_ORIGINS=http://localhost:3000
CA_BUCKET=crop-advisor-images
CA_CASES_TABLE=crop-advisor-dev-cases
CA_KB_INDEX=crop_knowledge
CA_SAGEMAKER_ENDPOINT=crop-advisor-classifier-dev
CA_SARVAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
CA_GUARDRAIL_ID=
CA_GUARDRAIL_VERSION=1
LANGFUSE_HOST=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# LLM (OpenAI-compatible, Nemotron 3.5 Super VL) - fill in values
CA_LLM_BASE_URL=
CA_LLM_API_KEY=
CA_LLM_MODEL_NAME=
# Vision second opinion (sends the image to the model) - off by default
CA_VISION_SECOND_OPINION=false