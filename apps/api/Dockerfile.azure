# Azure Container Apps image for the crop-advisor API.
#
# Build context is the repository root:
#   docker build --platform linux/amd64 -f apps/api/Dockerfile.azure -t crop-advisor-api:azure .
#
# No torch: the classifier runs on ONNX Runtime, which is ~50MB instead of
# ~2.5GB and starts in seconds.
FROM python:3.12-slim

WORKDIR /app

COPY apps/api/requirements-azure.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Application code.
COPY agents/ ./agents/
COPY mcp_servers/ ./mcp_servers/
COPY rag/ ./rag/
COPY speech/ ./speech/
COPY strings/ ./strings/
COPY apps/api/ ./apps/api/

# The ONNX classifier.
COPY ml/export_edge/artifacts/ ./ml/export_edge/artifacts/

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    CA_REGION=ap-south-1

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
