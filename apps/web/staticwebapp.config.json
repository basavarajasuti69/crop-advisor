{
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript",
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/manifest.json",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "globalHeaders": {
    "Cache-Control": "public, max-age=3600"
  }
}
